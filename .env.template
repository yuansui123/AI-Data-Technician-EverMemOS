# Copy this file to .env and fill in your keys.
# Never commit .env — it is gitignored.
#
# SECURITY: For deployed demos, store this file OUTSIDE the app directory
# (e.g. ~/.env) and load via systemd EnvironmentFile. The agent's sandbox
# can read files inside the project directory.

ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
EVERMEMOS_API_KEY=

# Memory backend: "file", "evermemos_cloud", "evermemos_local", or "hybrid"
MEMORY_BACKEND=evermemos_cloud

# Sandbox backend: "local" (subprocess) or "docker" (isolated containers)
SANDBOX_BACKEND=local
